{
  "schema": "hoi4.replay.package-install-matrix.v1",
  "product_id": "battle-plan",
  "status": "mechanics_wired_policy_inputs_pending",
  "product_surfaces": [
    {
      "id": "standalone_replay",
      "authority": "replay_package_runtime",
      "required_installed_roles": [
        "platform_signed_stable_launcher",
        "canonical_active_release_pointer",
        "content_addressed_signed_version_tree",
        "manifest_declared_replay_entrypoint",
        "manifest_declared_replay_prefold_worker_sibling"
      ]
    },
    {
      "id": "resident_recorder",
      "authority": "recorder_host.auto_attach.product_runtime",
      "required_installed_roles": [
        "platform_signed_recorder_host",
        "nonempty_non_alias_collector.dll_in_same_canonical_directory",
        "known_folder_product_data_root"
      ],
      "fixed_runtime_rule": "ordinary_resolution_never_searches_path_registry_steam_or_profile_locations"
    }
  ],
  "transaction_order": [
    "build_unsigned_manifest",
    "external_sign_raw_package_digest",
    "write_canonical_replay-package.json",
    "retain_staged_release",
    "promote_release",
    "invoke_active_release_from_current_launcher"
  ],
  "mechanical_cases": [
    {
      "id": "I01_clean_first_install",
      "operation": "retain_then_promote",
      "expected": "digest_directory_verified_generation_1_previous_absent"
    },
    {
      "id": "I02_identical_reinstall",
      "operation": "retain_same_digest",
      "expected": "existing_tree_reverified_no_rewrite_no_pointer_change"
    },
    {
      "id": "I03_upgrade",
      "operation": "retain_then_policy_admitted_promote",
      "expected": "generation_incremented_old_current_retained_as_previous"
    },
    {
      "id": "I04_interrupted_copy",
      "operation": "terminate_before_incoming_directory_rename",
      "expected": "active_pointer_unchanged_inert_incoming_residue_only"
    },
    {
      "id": "I05_interrupted_pointer_replace",
      "operation": "terminate_during_promote_release_atomic_replace",
      "expected": "complete_old_or_complete_new_canonical_pointer"
    },
    {
      "id": "I06_tamper_and_aliases",
      "operation": "alter_remove_add_hardlink_symlink_or_reparse_package_path",
      "expected": "verification_refused_before_process_callback"
    },
    {
      "id": "I07_corrupt_occupied_digest",
      "operation": "retain_when_digest_directory_already_contains_other_bytes",
      "expected": "existing_tree_refused_and_never_replaced"
    },
    {
      "id": "I08_wrong_identity",
      "operation": "admit_signed_other_product_or_target",
      "expected": "retention_promotion_and_launch_refused"
    },
    {
      "id": "I09_signature_failure",
      "operation": "omit_signature_or_use_unknown_revoked_or_invalid_signer",
      "expected": "production_admission_refused"
    },
    {
      "id": "I10_release_policy_failure",
      "operation": "attempt_downgrade_channel_hop_or_disallowed_active_release",
      "expected": "pointer_mutation_or_launch_refused"
    },
    {
      "id": "I11_pointer_race",
      "operation": "change_active_pointer_during_launch_verification",
      "expected": "reread_detects_drift_and_process_callback_is_not_called"
    },
    {
      "id": "I12_rollback",
      "operation": "rollback_to_retained_previous",
      "expected": "both_trees_and_policies_verified_before_atomic_swap"
    },
    {
      "id": "I13_stale_lock",
      "operation": "mutate_with_existing_package_update_lock",
      "expected": "mutation_refused_pending_explicit_operator_recovery"
    },
    {
      "id": "I14_acl",
      "operation": "unprivileged_write_to_launcher_pointer_or_version_tree",
      "expected": "os_denies_write_and_runtime_refuses_any_resulting_tamper"
    },
    {
      "id": "I15_argument_integrity",
      "operation": "launch_with_spaces_quotes_and_shell_metacharacters_in_user_arguments",
      "expected": "opaque_os_arguments_forwarded_without_shell_interpretation"
    },
    {
      "id": "I16_prefold_worker_sibling",
      "operation": "open_compact_only_recording_with_manifest_listed_worker_beside_replay_app_then_remove_replace_or_alias_worker",
      "expected": "valid_worker_executes_single_certified_world_fold_missing_nonregular_or_symlink_worker_refuses_without_search_fallback"
    },
    {
      "id": "R01_recorder_sibling_payload",
      "operation": "resolve_ordinary_collector_payload_from_installed_recorder",
      "expected": "exact_nonempty_non_alias_collector.dll_in_canonical_executable_directory"
    },
    {
      "id": "R02_recorder_missing_or_alias_payload",
      "operation": "remove_empty_symlink_or_redirect_collector.dll",
      "expected": "recorder_start_refused_without_path_registry_or_download_fallback"
    },
    {
      "id": "R03_recorder_support_override",
      "operation": "supply_explicit_collector_payload_override",
      "expected": "override_is_still_required_to_be_a_nonempty_regular_non_symlink_file"
    },
    {
      "id": "R04_recorder_data_root",
      "operation": "resolve_ordinary_product_data_location",
      "expected": "local_app_data_known_folder_plus_fixed_product_directory_without_profile_or_drive_guessing"
    }
  ],
  "human_product_policy_inputs": [
    "detached_signature_algorithm_and_signer_identity_format",
    "public_trust_material_rotation_and_revocation",
    "launcher_and_installer_platform_code_signing_identity",
    "per_user_or_per_machine_install_scope_and_os_acls",
    "download_transport_and_staging_retention",
    "stale_lock_and_incoming_residue_recovery",
    "release_channel_downgrade_and_emergency_rollback_policy",
    "windows_dll_search_and_process_mitigation_policy",
    "combined_or_separate_replay_and_recorder_install_topology"
  ],
  "explicitly_out_of_scope": [
    "private_signing_keys",
    "downloader_network_transport",
    "tray_or_window_ui",
    "guessing_steam_hoi4_or_profile_paths"
  ]
}

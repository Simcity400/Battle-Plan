{
  "name": "battleplan",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node tools/desktop.mjs dev",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build:ui": "tsc -p ui/tsconfig.json && vite build --config ui/vite.config.ts",
    "check:ui": "tsc --noEmit -p ui/tsconfig.json && node tools/test-ui.mjs --check-imports",
    "test:ui": "node tools/test-ui.mjs",
    "test:ui:tab-full": "node tools/test-ui.mjs --tab-full",
    "audit:ui": "npm audit",
    "build:desktop": "node tools/desktop.mjs build",
    "parity:compare": "python ui/e2e/owned_job.py node ui/e2e/run.mjs compare",
    "test:parity": "python ui/e2e/owned_job.py node --test ui/e2e/review.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cascadia-code": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/roboto-condensed": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@msgpack/msgpack": "3.1.3",
    "@tauri-apps/api": "2.12.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-grid-layout": "2.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright-core": "1.65.1",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "undici": "8.13.1",
    "vite": "8.3.8"
  }
}

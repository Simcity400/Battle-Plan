{
  "name": "battle-plan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node tools/desktop.mjs dev",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build:ui": "tsc -p ui/tsconfig.json && vite build --config ui/vite.config.ts",
    "check:ui": "tsc --noEmit -p ui/tsconfig.json",
    "build:desktop": "node tools/desktop.mjs build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "echarts": "6.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}

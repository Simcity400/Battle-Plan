{
  "name": "battle-plan",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node tools/desktop.mjs dev",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build:ui": "tsc -p ui/tsconfig.json && vite build --config ui/vite.config.ts",
    "check:ui": "tsc --noEmit -p ui/tsconfig.json",
    "test:ui": "node --experimental-strip-types --test \"ui/src/**/*.test.ts\"",
    "audit:ui": "npm audit",
    "build:desktop": "node tools/desktop.mjs build"
  },
  "dependencies": {
    "@fontsource-variable/cascadia-code": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/roboto-condensed": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@tauri-apps/api": "2.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-grid-layout": "2.2.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}

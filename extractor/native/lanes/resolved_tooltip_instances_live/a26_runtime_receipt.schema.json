{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a26_runtime_receipt.schema.json",
  "title": "A26 same-Present runtime matrix receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assembled_utc",
    "source_case_receipts",
    "cases",
    "matrix_sha256"
  ],
  "properties": {
    "schema": {
      "const": "a26-same-present-runtime-receipt-v1"
    },
    "assembled_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source_case_receipts": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cases": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "case_id",
          "process_start_nonce",
          "hook_install_epoch",
          "executable_sha256",
          "producer_manifest_sha256",
          "viewport",
          "selected_present",
          "hook_observation",
          "d72",
          "fold",
          "replay",
          "case_receipt_file_sha256"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "process_start_nonce": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "hook_install_epoch": {
            "type": "integer",
            "minimum": 1
          },
          "executable_sha256": {
            "const": "870ebf1f615262facca48a3b947775c41f0a5338f3068c40958209f5c41c65ad"
          },
          "producer_manifest_sha256": {
            "const": "a23b63ccefc021eeced9a1a918588d3e2fbba07e5d1afb4d53f83cc7c1640177"
          },
          "viewport": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "selected_present": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_count",
              "candidate_set_sha256",
              "selected_candidate_id",
              "selected_ordinal",
              "selected_game_hour_raw",
              "selected_qpc_ticks",
              "selection_cutoff_qpc_ticks",
              "frame_hour",
              "receipt_sha256"
            ],
            "properties": {
              "candidate_count": {"type": "integer", "minimum": 1},
              "candidate_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "selected_candidate_id": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
              "selected_ordinal": {"type": "integer", "minimum": 0},
              "selected_game_hour_raw": {"type": "integer"},
              "selected_qpc_ticks": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
              "selection_cutoff_qpc_ticks": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
              "frame_hour": {"type": "integer", "minimum": 0},
              "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "case_receipt_file_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "matrix_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

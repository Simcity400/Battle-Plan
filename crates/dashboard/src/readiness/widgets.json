        {"product": "idea-history", "route": "prepared", "firstView": "d", "params": {"branchId": "$branch", "tag": "$tag", "through": "$first", "preview": true}}
      ]
    },
    {
      "kind": "national-spirits",
      "requests": [
        {"product": "idea-history", "route": "prepared", "firstView": "d", "params": {"branchId": "$branch", "tag": "$tag", "hour": "$first", "preview": false}}
      ]
    },
    {
      "kind": "spirit-history",
      "requests": [
        {"product": "idea-history", "route": "prepared", "firstView": "d", "params": {"branchId": "$branch", "tag": "$tag", "through": "$first", "preview": true}}
      ]
    },
    {
      "kind": "ruling-party",
      "requests": [
        {"product": "party-history", "route": "prepared", "params": {"branchId": "$branch", "tag": "$tag", "mode": "summary", "from": "$first", "to": "$last", "width": "$width", "fields": ["ruling", "leader", "election"], "values": true}},
        {"product": "party-history", "route": "prepared", "params": {"branchId": "$branch", "tag": "$tag", "mode": "state", "hours": ["$last"], "fields": ["ruling", "leader", "election"], "values": true}}
      ]
    },
    {
      "kind": "resource-balance",
      "requests": [
        {"product": "resource-balance", "route": "prepared", "params": {"branchId": "$branch", "tag": "$tag", "from": "$last", "to": "$last", "hours": ["$last"]}}
      ]

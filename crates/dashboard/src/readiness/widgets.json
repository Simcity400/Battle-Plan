    },
    {
      "kind": "factories",
      "requests": [
        {"product": "series-summary", "route": "prepared", "params": {"branchId": "$branch", "tags": [], "family": {"kind": "country-factories", "top": {"count": 10, "mode": "free", "groups": []}, "mode": "free", "groups": []}, "from": "$last", "to": "$last", "width": 1, "requireParts": false}}
      ],
      "note": "The default race reads the playhead hour; lines over time read the chart's viewport."
    },
    {
      "kind": "territory",
      "requests": [
        {"product": "series-state", "route": "prepared", "params": {"branchId": "$branch", "family": {"kind": "territory", "metadata": true}, "reads": [{"hour": "$first"}]}},
        {"product": "series-state", "route": "prepared", "params": {"branchId": "$branch", "family": {"kind": "territory", "measure": "states", "rule": "controlled", "top": 10, "aggregate": false}, "tags": [], "unobserved": [], "reads": [{"hour": "$last"}]}}
      ]
    },
    {
      "kind": "territory-breakdown",
      "requests": [
        {"product": "series-state", "route": "prepared", "params": {"branchId": "$branch", "family": {"kind": "territory", "measure": "states", "rule": "controlled", "breakdown": true}, "tags": [], "reads": [{"hour": "$last"}]}}
      ]
    },
    {
      "kind": "equipment-losses",
      "requests": [
        {"product": "country-groups", "route": "prepared", "firstView": "b", "params": {"branchId": "$branch"}}
      ],
      "note": "The losses query names the chosen holder's native identity from the country groups reply; the probe does not issue that dependent query."
    },
    {
      "kind": "equipment-produced",
      "requests": [
        {"product": "production-select", "route": "prepared", "firstView": "d", "params": {"hour": "$last", "selection": {"branchId": "$branch", "tags": [], "top": 10, "measure": "day", "count": "units", "grouping": "type", "included": [], "refits": false}, "offset": "0", "limit": 10, "ranked": true}}
      ],
      "note": "The widget's default measure is the day. It asks for its most delivered type's designs once it has chosen that type; the probe asks for every type and does not issue the type choice's request."
    },
    {
      "kind": "production-spending",
      "requests": [
        {"product": "production-spending", "route": "prepared", "firstView": "d", "params": {"branchId": "$branch", "tag": "$tag", "refits": false, "from": null, "hour": "$last", "end": "$last"}}
      ]
    },
    {
      "kind": "occupied-states",
      "requests": [
        {"product": "occupied-states-manifest", "route": "prepared", "firstView": "d", "params": {"branchId": "$branch"}},
        {"product": "occupied-states", "route": "prepared", "firstView": "c", "params": {"branchId": "$branch", "window": "$window:0:last"}}

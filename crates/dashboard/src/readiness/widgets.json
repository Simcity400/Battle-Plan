        {"product": "series-summary", "route": "prepared", "firstView": "b", "params": {"branchId": "$branch", "family": {"kind": "occupation-trend", "measure": "resistance", "rankMeasure": "resistance", "top": null, "collaboration": false, "both": false}, "tags": [], "from": "$first", "to": "$last", "width": "$width"}}
      ]
    },
    {
      "kind": "air-force-size",
      "requests": [
        {"product": "series-summary", "route": "prepared", "params": {"branchId": "$branch", "tags": [], "family": {"kind": "air-force-size", "top": 10, "measure": "planes", "ownership": "roster"}, "from": "$last", "to": "$last", "width": 1, "requireParts": false}}
      ]
    },
    {
      "kind": "navy-size",
      "requests": [
        {"product": "series-summary", "route": "prepared", "params": {"branchId": "$branch", "tags": [], "family": {"kind": "navy-size", "top": 10, "ownership": "roster", "grouping": "class", "measure": "ships"}, "from": "$last", "to": "$last", "width": 1, "requireParts": false}}
      ]

{
  "widgets": [
    {
      "kind": "map",
      "map": true,
      "note": "The viewer's first frame at the opening hour, through committed checkpoints or the recording."
    },
    {
      "kind": "national-focus",
      "requests": [
        {"product": "focus-hour", "route": "prepared", "firstView": "a", "params": {"branchId": "$branch", "tag": "$tag", "hour": "$last"}}
      ],
      "note": "Its order and presentation pages follow the hour's reply; they read the recorded order at that hour while completion dates are still being prepared."
    },
    {
      "kind": "active-research",
      "requests": [
        {"product": "series-state", "route": "prepared", "firstView": "a", "params": {"branchId": "$branch", "family": {"kind": "research"}, "reads": [{"tag": "$tag", "hour": "$first"}]}}
      ]
    },
    {
      "kind": "research",
      "requests": [
        {"product": "events-page", "route": "prepared", "firstView": "d", "params": {"branchId": "$branch", "tag": "$tag", "family": {"kind": "research"}}}
      ]
    },
    {
      "kind": "political-power",
      "requests": [
        {"product": "series-summary", "route": "prepared", "params": {"branchId": "$branch", "family": {"kind": "country-measure", "measure": "politicalPower"}, "tags": "$tags", "from": "$first", "to": "$last", "width": "$width", "withMarks": true}},
        {"product": "series-state", "route": "prepared", "params": {"branchId": "$branch", "family": {"kind": "country-measure", "measure": "politicalPower"}, "reads": [{"tag": "$tag", "hour": "$last"}]}}
      ]
    },
    {
      "kind": "political-power-spending",
      "requests": [
        {"product": "country-groups", "route": "prepared", "firstView": "b", "params": {"branchId": "$branch"}},
        {"product": "politics-ledger", "route": "prepared", "firstView": "d", "params": {"branchId": "$branch", "tag": "$tag", "view": "spending", "hour": "$first", "totals": false}}
      ],
      "note": "Spending tables match countries by native identity, read from the country groups reply."
    },
    {
      "kind": "political-power-spending-breakdown",
      "requests": [
        {"product": "country-groups", "route": "prepared", "firstView": "b", "params": {"branchId": "$branch"}},
        {"product": "politics-ledger", "route": "prepared", "firstView": "d", "params": {"branchId": "$branch", "tag": "$tag", "view": "spending", "hour": "$last", "totals": true}}
      ],
      "note": "Spending tables match countries by native identity, read from the country groups reply."
    },
    {
      "kind": "command-power",
      "requests": [
        {"product": "series-summary", "route": "prepared", "params": {"branchId": "$branch", "family": {"kind": "country-measure", "measure": "commandPower"}, "tags": "$tags", "from": "$first", "to": "$last", "width": "$width", "withMarks": true}},
        {"product": "series-state", "route": "prepared", "params": {"branchId": "$branch", "family": {"kind": "country-measure", "measure": "commandPower"}, "reads": [{"tag": "$tag", "hour": "$last"}]}},
        {"product": "series-summary", "route": "prepared", "params": {"branchId": "$branch", "family": {"kind": "country-stability", "measure": "maxCommandPower"}, "tags": "$tags", "from": "$first", "to": "$last", "width": "$width", "withMarks": false}},
        {"product": "series-state", "route": "prepared", "params": {"branchId": "$branch", "family": {"kind": "country-stability", "measure": "maxCommandPower"}, "reads": [{"tag": "$tag", "hour": "$last"}]}}
      ],
      "note": "The maximum line is on by default."
    },
    {
      "kind": "command-power-spending",
      "requests": [
        {"product": "country-groups", "route": "prepared", "firstView": "b", "params": {"branchId": "$branch"}},
        {"product": "politics-ledger", "route": "prepared", "firstView": "d", "params": {"branchId": "$branch", "tag": "$tag", "view": "spending", "hour": "$first", "totals": false}}
      ],
      "note": "Spending tables match countries by native identity, read from the country groups reply."
    },
    {
      "kind": "stability",

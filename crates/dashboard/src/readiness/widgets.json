    {
      "kind": "equipment-stockpile",
      "requests": [
        {"product": "equipment-stockpile", "route": "prepared", "firstView": "a", "params": {"branchId": "$branch", "tag": "$tag", "from": "$last", "to": "$last", "width": 1, "included": []}}
      ]
    },
    {
      "kind": "fuel",
      "requests": [
        {"product": "series-summary", "route": "prepared", "params": {"branchId": "$branch", "family": {"kind": "country-fuel"}, "tags": "$tags", "measures": ["fuel", "capacity", "stripGain", "stripBurn"], "from": "$first", "to": "$last", "width": "$width"}},
        {"product": "series-state", "route": "prepared", "params": {"branchId": "$branch", "family": {"kind": "country-fuel"}, "reads": [{"tag": "$tag", "hour": "$last"}]}}

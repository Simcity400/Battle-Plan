        {"product": "series-summary", "route": "prepared", "firstView": "d", "params": {"branchId": "$branch", "family": {"kind": "country-experience", "measure": "navy-banked"}, "tags": "$experienceTags:0", "from": "$first", "to": "$last", "width": "$width", "withMarks": false}},
        {"product": "series-summary", "route": "prepared", "firstView": "d", "params": {"branchId": "$branch", "family": {"kind": "country-experience", "measure": "air-banked"}, "tags": "$experienceTags:0", "from": "$first", "to": "$last", "width": "$width", "withMarks": false}},
        {"product": "series-state", "route": "prepared", "firstView": "b", "params": {"branchId": "$branch", "family": {"kind": "country-experience", "measure": "army-banked"}, "reads": "$experienceReads:0"}}

      ]
    },
    {
      "kind": "bombing-damage",
      "requests": [
        {"product": "military-air-ledger", "route": "prepared", "firstView": "d", "params": {"branchId": "$branch", "family": "bombing", "regions": [], "causes": [], "fromHour": null, "top": {"count": 10, "metric": "total"}}}
      ]
    },
    {
      "kind": "bombing-damage-breakdown",
      "requests": [
        {"product": "military-air-ledger", "route": "prepared", "firstView": "d", "params": {"branchId": "$branch", "family": "bombing", "regions": [], "causes": [], "fromHour": null, "top": null}}

        {"product": "series-state", "route": "prepared", "params": {"branchId": "$branch", "family": {"kind": "country-stability", "measure": "stability"}, "reads": [{"tag": "$tag", "hour": "$last"}]}},
        {"product": "series-summary", "route": "prepared", "params": {"branchId": "$branch", "family": {"kind": "country-stability", "measure": "warSupport"}, "tags": "$tags", "from": "$first", "to": "$last", "width": "$width", "withMarks": false}},
        {"product": "series-state", "route": "prepared", "params": {"branchId": "$branch", "family": {"kind": "country-stability", "measure": "warSupport"}, "reads": [{"tag": "$tag", "hour": "$last"}]}}
      ],
      "auxiliary": [
        {"product": "country-groups", "route": "prepared", "firstView": "b", "params": {"branchId": "$branch"}}
      ]

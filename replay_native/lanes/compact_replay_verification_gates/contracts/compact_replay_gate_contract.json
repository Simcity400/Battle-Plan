{
  "contract": "compact_replay_verification_gates_v1",
  "production_path": "hoi4.exe -> collector.dll -> typed compact domain records -> Rust recorder -> native_session.battleplan",
  "required_manifest_fields": [
    "schema",
    "stream_format",
    "extraction_perf_gate",
    "scheduled_domains",
    "compact_stream",
    "hourly_requirement",
    "skipped_game_hours",
    "raw_stream",
    "replay_file",
    "replay_entries"
  ],
  "hard_gates": [
    "stream_format == compact",
    "extraction_perf_gate == true",
    "compact_stream.decodable == true",
    "compact_stream.ordered == true",
    "compact_stream.domain_coverage.ok == true",
    "parse_errors and ordering_errors are empty",
    "hourly_requirement.met == true",
    "game_hours_advanced >= requested_game_hours",
    "skipped_game_hours == 0",
    "one FRAME_END per covered game hour",
    "one DOMAIN_PERF record per scheduled domain per covered game hour",
    "one DOMAIN_DATA record per scheduled typed domain per covered game hour",
    "worker_panic_seen, bridge_unavailable_seen, source_unavailable_seen, and partial_data_seen are false",
    "bridge row counters are zero",
    "root source/debt fields are clean for scheduled root-owning domains",
    "collector_stream.bin byte length matches compact_stream.total_bytes",
    "native_session.battleplan opens, verify_all passes, and its collector_compact_stream bytes match collector_stream.bin"
  ],
  "default_byte_limits": {
    "max_stream_bytes": 134217728,
    "max_record_bytes": 8388608,
    "max_bytes_per_frame": 2097152
  },
  "known_domains": [
    {"id": 10, "name": "fuel_live", "required_units": ["fuel_country_rows"], "shared_recorder_known": true},
    {"id": 11, "name": "production_live", "required_units": ["production_country_rows", "stockpile_rows", "military_line_rows", "naval_line_rows", "construction_queue_rows"], "shared_recorder_known": true},
    {"id": 12, "name": "focus_live", "required_units": ["focus_country_rows"], "shared_recorder_known": true},
    {"id": 13, "name": "tech_live", "required_units": ["tech_country_rows", "active_research_slot_rows"], "shared_recorder_known": true},
